# Copy to .env for `npm run dev` and `npm run deploy`. Alchemy reads it (shell variables win) and turns each
# value into a Worker variable or secret (alchemy.run.ts). Cloudflare resources (D1, R2, Queues, Durable
# Objects, cron) are created and bound by the stack: there are no database or service URLs to set.
# Required: ADMIN_EMAIL, ADMIN_PASSWORD (12+ characters), SESSION_SECRET (32+). Everything else can wait.
# Use a separate file per stage, e.g. `npm run deploy -- --stage prod --env-file .env.prod`.

# ─── Required ──────────────────────────────────────────────────────────────────

# The one dashboard login. The password needs at least 12 characters, or Mailcheap refuses to log in.
# Changing either one signs out every session.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Signs the login session and every link in your emails (unsubscribe, confirm, tracking).
# At least 32 random characters: openssl rand -base64 48. Generate one per install and keep it:
# changing it later breaks the unsubscribe links in emails already sent.
SESSION_SECRET=

# ─── Domains ───────────────────────────────────────────────────────────────────

# The dashboard and email links. Its zone must be on the same Cloudflare account. Empty: the Worker's
# workers.dev URL, fine for trying it out. Set it before the first real email: links in sent emails use it.
APP_DOMAIN=

# Image uploads, served from the R2 asset bucket. Empty: the app serves them at APP_DOMAIN/media.
ASSET_DOMAIN=

# Archive domains: news.example.com=weekly serves the "weekly" newsletter's archive at that domain.
# Comma-separated for several newsletters. Point the domain at the app Worker first (a Cloudflare route or
# custom domain). It's the safer setup: issue HTML then never shares the dashboard's origin.
ARCHIVE_HOSTS=

# ─── Sending ───────────────────────────────────────────────────────────────────

# Kill switch: nothing is sent unless this is exactly "true". Both Workers read it, so redeploy with
# anything else to stop every send, including queued ones. Leave it off until SES and SNS are set up.
SENDING_ENABLED=false

# ─── Amazon SES (sending) and SNS (bounces, complaints, deliveries) ─────────────

SES_REGION=us-east-1
# IAM user keys (see the README for the policy). Stored as Worker secrets.
SES_ACCESS_KEY_ID=
SES_SECRET_ACCESS_KEY=
# Configuration set whose event destination publishes to the SNS topic below.
SES_CONFIGURATION_SET=
# SNS topic ARN that delivers SES events to the sesWebhookUrl printed by the deploy.
SES_SNS_TOPIC_ARN=

# Emails per second across all sends, 1 to 14 (default 10). Keep it under the SES account's own rate.
SEND_RATE_PER_SECOND=

# ─── Optional ──────────────────────────────────────────────────────────────────

# Alerts by email to ADMIN_EMAIL (spam complaints, paused sends, unconfirmed sends, signup floods, rate
# limiter outages, and every login, new API key and send), sent through SES from this address on a
# verified domain, e.g. Mailcheap <alerts@mail.example.com>. Empty: logs only.
ALERT_FROM=

# ─── Deploying from CI (not needed locally after `alchemy profile login`) ───────

# CLOUDFLARE_ACCOUNT_ID=
# CLOUDFLARE_API_TOKEN=
